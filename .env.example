# Supabase — proyecto facturitaapp
SUPABASE_URL=https://uskadkxmxizcnhvhbwql.supabase.co
SUPABASE_ANON_KEY=sb_publishable_JrX1jjcRjrX3prVCEQsjOA_v5krGdnW
# Secreta — copiala del dashboard (Settings → API → service_role). Necesaria para el scheduler (Fase 7).
SUPABASE_SERVICE_ROLE_KEY=
PORT=3000

# Email de notificaciones (Fase 8) — opcional. Ej. Gmail con app password:
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Cifrado at-rest de credenciales sensibles (cert/key/access_token/tokens de Drive)
# y firma del state de OAuth. Generá cada una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANTE: si perdés APP_ENCRYPTION_KEY no vas a poder desencriptar los certificados guardados.
APP_ENCRYPTION_KEY=
OAUTH_STATE_SECRET=

# Origen del frontend (para CORS y el postMessage del callback de Drive).
CLIENT_ORIGIN=http://localhost:5173
# URL pública del backend (para el redirect de OAuth de Google Drive; en producción poné tu dominio).
OAUTH_REDIRECT_URI=http://localhost:3000/api/drive/callback

# Credenciales de la app de Google (para conectar Drive con un click).
# Reusá el MISMO cliente OAuth del login. El usuario final no carga nada.
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
